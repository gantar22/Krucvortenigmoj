<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<crossword-compiler-applet xmlns="http://crossword.info/xml/crossword-compiler">
  <applet-settings cursor-color="#ffff00" selected-cells-color="#00ff00">
    <actions buttons-layout="left">
      <reveal-word label="Reveal Word"/>
      <reveal-letter label="Reveal Letter"/>
      <check label="Check"/>
      <solution label="Solution"/>
      <pencil label="Pencil"/>
    </actions>
    <completion only-if-correct="true">Congratulations, you’ve solved the puzzle!</completion>
  </applet-settings>
  <rectangular-puzzle xmlns="http://crossword.info/xml/rectangular-puzzle">
    <metadata>
      <creator>rohtua</creator>
      <completion>Congratulations, you’ve solved the puzzle!</completion>
      <copyright>© 2025</copyright>
      <description>seton revlos</description>
      <created_at>2025-12-06</created_at>
      <title>eman</title>
      <type>crossword</type>
    </metadata>
    <crossword>
      <grid width="4" height="4">
        <cell x="1" y="1" number="1" bottom-bar="true"/>
        <cell x="1" y="2"/>
        <cell x="1" y="3"/>
        <cell x="1" y="4" number="6"/>
        <cell x="2" y="1"/>
        <cell x="2" y="2" number="3" right-bar="true"/>
        <cell x="2" y="3" number="5" left-bar="true"/>
        <cell x="2" y="4" bottom-bar="true"/>
        <cell x="3" y="1"/>
        <cell x="3" y="2" number="4"/>
        <cell x="3" y="3"/>
        <cell x="3" y="4"/>
        <cell x="4" y="1" number="2"/>
        <cell x="4" y="2" left-bar="true"/>
        <cell x="4" y="3" left-bar="true"/>
        <cell x="4" y="4"/>
      </grid>
      <word id="1">
        <cells x="1" y="1"/>
        <cells x="2" y="1"/>
        <cells x="3" y="1"/>
        <cells x="4" y="1"/>
      </word>
      <word id="2">
        <cells x="2" y="2"/>
        <cells x="3" y="2"/>
      </word>
      <word id="3">
        <cells x="2" y="3"/>
        <cells x="3" y="3"/>
      </word>
      <word id="4">
        <cells x="1" y="4"/>
        <cells x="2" y="4"/>
        <cells x="3" y="4"/>
        <cells x="4" y="4"/>
      </word>
      <word id="5">
        <cells x="1" y="1"/>
        <cells x="1" y="2"/>
        <cells x="1" y="3"/>
        <cells x="1" y="4"/>
      </word>
      <word id="6">
        <cells x="4" y="1"/>
        <cells x="4" y="2"/>
        <cells x="4" y="3"/>
        <cells x="4" y="4"/>
      </word>
      <word id="7">
        <cells x="2" y="2"/>
        <cells x="2" y="3"/>
      </word>
      <word id="8">
        <cells x="3" y="2"/>
        <cells x="3" y="3"/>
      </word>
      <clues>
        <title>Across</title>
        <clue number="1" word="1"/>
        <clue number="3" word="2"/>
        <clue number="5" word="3"/>
        <clue number="6" word="4"/>
      </clues>
      <clues>
        <title>Down</title>
        <clue number="1" word="5"/>
        <clue number="2" word="6"/>
        <clue number="3" word="7"/>
        <clue number="4" word="8"/>
      </clues>
    </crossword>
  </rectangular-puzzle>
</crossword-compiler-applet>
