<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<crossword-compiler-applet xmlns="http://crossword.info/xml/crossword-compiler">
  <applet-settings cursor-color="#ffff00" selected-cells-color="#00ff00">
    <actions buttons-layout="left">
      <reveal-word label="Reveal Word"/>
      <reveal-letter label="Reveal Letter"/>
      <check label="Check"/>
      <solution label="Solution"/>
      <pencil label="Pencil"/>
    </actions>
    <completion only-if-correct="true">Congratulations, you’ve solved the puzzle!</completion>
  </applet-settings>
  <rectangular-puzzle xmlns="http://crossword.info/xml/rectangular-puzzle">
    <metadata>
      <creator/>
      <completion>Congratulations, you’ve solved the puzzle!</completion>
      <copyright>© 2025</copyright>
      <description/>
      <created_at>2025-12-06</created_at>
      <title>Untitled Project</title>
      <type>crossword</type>
    </metadata>
    <crossword>
      <grid width="4" height="1">
        <cell x="1" y="1" solution="A"/>
        <cell x="2" y="1" solution="B" number="1" left-bar="true"/>
        <cell x="3" y="1" solution="C"/>
        <cell x="4" y="1" solution="D"/>
      </grid>
      <word id="1">
        <cells x="2" y="1"/>
        <cells x="3" y="1"/>
        <cells x="4" y="1"/>
      </word>
      <clues>
        <title>Across</title>
        <clue number="1" word="1">
          <span>eulc</span>
        </clue>
      </clues>
      <clues>
        <title>Down</title>
      </clues>
    </crossword>
  </rectangular-puzzle>
</crossword-compiler-applet>
